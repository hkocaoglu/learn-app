# Vercel dashboard -> Settings -> Environment Variables bölümüne ekleyin.
# Bu dosyaya gerçek API anahtarını yazmayın.
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://your-project.vercel.app
OPENROUTER_SITE_NAME=Sınıf Test

# Frontend için Supabase public değerleri.
# Vercel'de Preview ve Production ortamlarını gerektiğinde ayrı ayrı seçin.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Yalnızca Vercel Serverless Functions için kullanılır.
# Supabase Dashboard > Settings > API Keys > Secret keys içinden alınır.
# Bu anahtarı VITE_ ile başlatmayın ve frontend'e göndermeyin.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key
